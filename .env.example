# Copie para .env.local (web) e worker/.env (worker). NUNCA commitar os arquivos reais.

# --- Web (apps/web) ---
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable/anon key>
NEXT_PUBLIC_APP_URL=http://localhost:3000
TERMS_VERSION=1.0

# Somente servidor (rotas server do Next). Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# --- Worker (worker/) ---
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key>
WORKER_POLL_SECONDS=5
INGEST_MAX_BYTES=262144

# --- E-mail (semana 4) ---
RESEND_API_KEY=
ALERT_EMAIL_TO=

# --- Asaas (semana 3, depende de preços) ---
ASAAS_API_KEY=
ASAAS_ENV=sandbox

# Public address of the worker (used in the dashboard command for the Windows collector). No trailing slash.
WORKER_PUBLIC_URL=https://worker.exemplo.com.br
