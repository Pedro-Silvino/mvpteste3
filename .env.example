# Copie para apps/web/.env.local (web) e worker/.env (worker). NUNCA commitar os arquivos reais.

# --- Web (apps/web) ---
# O web NÃO usa a chave service role: tudo passa pela sessão do usuário e pelo RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable/anon key>
NEXT_PUBLIC_APP_URL=http://localhost:3000
TERMS_VERSION=1.0
# Endereço público do worker (aparece no comando do coletor Windows, em Coletor). Sem barra no final.
WORKER_PUBLIC_URL=https://worker.exemplo.com.br

# --- Worker (worker/) ---
# Service role: só aqui, no servidor do worker. Nunca no navegador, nunca com prefixo NEXT_PUBLIC_.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# --- E-mail (opcional; sem estas duas, o worker não envia e-mail e o resto funciona igual) ---
RESEND_API_KEY=
MAIL_FROM=Sentinela <alertas@datadops.com.br>
# Quem da equipe recebe o aviso de SOS por e-mail (o alerta também aparece em /staff).
STAFF_ALERT_EMAIL=

# --- Asaas (depende dos preços; ainda não usado) ---
ASAAS_API_KEY=
ASAAS_ENV=sandbox

# --- CAT-TPRM (ciclo 4)
# Web: endereço público do worker, para o fornecedor enviar provas direto (ex.: https://worker.exemplo.com.br)
NEXT_PUBLIC_WORKER_URL=
# Worker: origem do portal liberada no CORS (ex.: https://app.datadops.com.br)
APP_ORIGIN=
# Worker: segredo (24+ caracteres) do agendador que chama POST /tprm/reassess. Vazio = rota desligada.
TPRM_CRON_TOKEN=
