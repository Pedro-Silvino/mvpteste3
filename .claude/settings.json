  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/injetar-progresso.mjs\"" }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": [
        "./.env",
        "./.env.local",
        "./.env.development",
        "./.env.development.local",
        "./.env.production",
        "./.env.production.local",
        "./.env.test.local",
        "./supabase/.env"
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "*.npmjs.org",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com"
      ]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.supabase", "mode": "deny" }
      ],
      "envVars": [
        { "name": "SUPABASE_ACCESS_TOKEN", "mode": "deny" },
        { "name": "SUPABASE_SERVICE_ROLE_KEY", "mode": "deny" },
        { "name": "ASAAS_API_KEY", "mode": "deny" },
        { "name": "ZAPSIGN_API_TOKEN", "mode": "deny" },
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" }
      ]
    }
